# ================================
# VARIÁVEIS DE AMBIENTE - EXEMPLO
# ================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA compartilhe este arquivo com valores preenchidos!
# ================================

# ----- API Omie -----
# Ambiente CD (Contabilidade/Divisão)
APP_KEY_CD=
APP_SECRET_CD=

# Ambiente Matriz (Principal)
APP_KEY_MATRIZ=
APP_SECRET_MATRIZ=

# ----- Banco de Dados Turso (LibSQL HTTP Pipeline v2) -----
TURSO_DATABASE_URL=https://classroom.turso.com
TURSO_AUTH_TOKEN=

# ----- SMTP (E-mail para notificações) -----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app

# ----- Controle de Acesso -----
# Lista de usuários permitidos (separados por vírgula)
ALLOWED_USERS=user1@empresa.com,user2@empresa.com