{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/cron_sync", "destination": "/api/cron_sync.py" },
    { "source": "/data/produtos_turso.json", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ],
  "crons": [
    {
      "path": "/api/cron_sync",
      "schedule": "20 15 * * *"
    },
    {
      "path": "/api/cron_sync",
      "schedule": "30 21 * * *"
    }
  ]
}
