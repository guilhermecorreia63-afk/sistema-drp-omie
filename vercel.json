{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/cron_sync",
      "dest": "/api/cron_sync.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron_sync",
      "schedule": "20 15 * * *"
    },
    {
      "path": "/api/cron_sync",
      "schedule": "30 21 * * *"
    }
  ]
}
