{
  "version": 2,
  "rewrites": [
    { "source": "/api/cron_sync", "destination": "/api/cron_sync.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ],
  "crons": [
    {
      "path": "/api/cron_sync",
      "schedule": "20 15 * * *"
    },
    {
      "path": "/api/cron_sync",
      "schedule": "30 21 * * *"
    }
  ]
}
